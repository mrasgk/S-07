# Rukn Environment Configuration Example
# Copy to .env.local or set via environment variables in production

# Database Connection (PostgreSQL)
CONNECTIONSTRINGS__DEFAULTCONNECTION=Host=localhost;Port=5432;Database=rukn_db;Username=postgres;Password=your_password;SSL Mode=Prefer;Trust Server Certificate=true;

# Frontend Allowed Origins (CORS)
CORS__ALLOWEDORIGINS__0=http://localhost:3000

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Development
